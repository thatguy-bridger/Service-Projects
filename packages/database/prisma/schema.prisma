generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_URL_UNPOOLED")
  // ST_DWithin (duplicate detection within 25m), ST_Contains (territory
  // fill) and clustering all need this. See SPEC.md §5.
  extensions = [postgis]
}

// -------------------------------------------------------------------------
// Role. Rounds phase 0 migrates this from ADMIN|USER to five values.
// The migration for this enum is hand-written (see migrations/), not
// autogenerated: ADMIN rows must stay ADMIN and USER rows must become
// PREVIEWER, per SPEC.md §3.1 ("the safe direction — a USER in the old
// schema has no route assignments and should not silently gain access").
// -------------------------------------------------------------------------
enum Role {
  OWNER
  ADMIN
  COORDINATOR
  VOLUNTEER
  PREVIEWER
}

enum EventKind {
  FLAG_SETOUT
  FLAG_PICKUP
  FLYER_DELIVERY
  FUNDRAISER
  PICKUP_COLLECTION
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum StopSource {
  SUBSCRIPTION
  SURVEY
  CSV_IMPORT
  TERRITORY_FILL
  MANUAL_PIN
  CARRIED_OVER
  FIELD_ADDED
}

enum StopStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  DONE
  SKIPPED
  ISSUE
}

enum SubStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  LAPSED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime? // NextAuth's PrismaAdapter expects this exact field
  role          Role      @default(PREVIEWER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Records this user created (only meaningful for ADMIN users) — belongs
  // to apps/route-assignments, untouched by Rounds.
  createdRecords ServiceRecord[] @relation("RecordAuthor")
  interactions   Interaction[]

  // Rounds: which orgs/events this user has a role in.
  memberships Membership[]

  // NextAuth PrismaAdapter — Google account linking. No `Session` model:
  // both apps use the "jwt" session strategy, and NextAuth never calls the
  // adapter's session methods under that strategy, so it's safe to omit.
  accounts Account[]
}

// NextAuth v4 PrismaAdapter's expected shape for OAuth account linking
// (Google). Field names are fixed by the adapter, not ours to rename.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth v4 PrismaAdapter's expected shape for email magic-link tokens.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Example of "data created by service administrators" that end users view/interact with.
// Each app under apps/* can extend this pattern with its own domain-specific tables.
model ServiceRecord {
  id        String   @id @default(cuid())
  title     String
  body      String
  authorId  String
  author    User     @relation("RecordAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interactions Interaction[]
}

model Interaction {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  recordId  String
  record    ServiceRecord @relation(fields: [recordId], references: [id])
  type      String // e.g. "comment", "request", "acknowledge"
  content   String?
  createdAt DateTime      @default(now())
}

// =========================================================================
// Rounds (apps/rounds) — Phase 0 + Phase 1 (flag subscription model)
// See SPEC.md §5. Still not added: Signup, FormSchema, Territory, Route,
// RouteAssignment, Visit, VolunteerAvailability, InviteKey, KeyRedemption,
// Notification — they land with the phases that need them.
// =========================================================================

model Organization {
  id       String @id @default(cuid())
  name     String
  slug     String @unique
  branding Json   @default("{}") // logo, accent override, terminology pack — SPEC.md §11.2
  settings Json   @default("{}") // feature flags, timezone, stripeAccountId

  memberships Membership[]
  events      Event[]
  households  Household[]
  seasons     Season[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?
}

model Season {
  id             String       @id @default(cuid())
  orgId          String
  organization   Organization @relation(fields: [orgId], references: [id])
  year           Int
  name           String // "2027 Flag Season"
  priceCents     Int // per selected holiday, or flat — see pricingMode
  pricingMode    String // "per_holiday" | "flat"
  renewalOpensAt DateTime?

  events        Event[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())

  @@unique([orgId, year])
}

model Membership {
  id              String       @id @default(cuid())
  orgId           String
  organization    Organization @relation(fields: [orgId], references: [id])
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  role            Role
  eventId         String? // null = org-wide
  event           Event?       @relation(fields: [eventId], references: [id])
  grantedBy       String?
  grantedViaKeyId String? // InviteKey ships in Phase 5; kept as a plain id for now
  status          String       @default("active")
  createdAt       DateTime     @default(now())

  @@unique([orgId, userId, role, eventId])
  @@index([userId])
}

model Event {
  id              String       @id @default(cuid())
  orgId           String
  organization    Organization @relation(fields: [orgId], references: [id])
  seasonId        String?
  season          Season?      @relation(fields: [seasonId], references: [id])
  kind            EventKind
  name            String
  slug            String
  status          EventStatus  @default(DRAFT)
  summary         String?
  descriptionMd   String?
  coverImageUrl   String?
  serviceStartsAt DateTime
  serviceEndsAt   DateTime
  signupsCloseAt  DateTime?
  timezone        String       @default("America/Denver")
  depotLat        Float?
  depotLng        Float?
  pairedEventId   String? // FLAG_SETOUT <-> FLAG_PICKUP, SPEC.md §2.1
  modules         Json // resolved module matrix, SPEC.md §2.1
  outcomeSet      Json // this kind's visit outcomes, overridable
  copyOverrides   Json?
  layoutBlocks    Json?
  createdBy       String
  createdAt       DateTime     @default(now())
  deletedAt       DateTime?

  stops              Stop[]
  memberships        Membership[]
  subscriptionEvents SubscriptionEvent[]

  @@unique([orgId, slug])
}

model Household {
  id                   String       @id @default(cuid())
  orgId                String
  organization         Organization @relation(fields: [orgId], references: [id])
  contactName          String
  contactEmail         String?
  contactPhone         String?
  addressInput         String // exactly what they typed
  address              Json // normalised components from the geocoder
  lat                  Float?
  lng                  Float?
  geocodeConfidence    Float?
  geocodeSource        String? // "ugrc" | "manual_pin"
  needsReview          Boolean      @default(false)
  placementNote        String? // "left of the driveway"
  accessNotes          String? // dog, stairs, sprinklers
  language             String       @default("en")
  selfServiceTokenHash String?

  stops         Stop[]
  subscriptions Subscription[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([orgId, lat, lng])
}

model Subscription {
  id                      String       @id @default(cuid())
  householdId             String
  household               Household    @relation(fields: [householdId], references: [id])
  seasonId                String
  season                  Season       @relation(fields: [seasonId], references: [id])
  status                  SubStatus    @default(DRAFT)
  amountCents             Int
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  renewedFromId           String? // last year's subscription
  cancelledAt             DateTime?

  events SubscriptionEvent[]

  createdAt DateTime @default(now())

  @@unique([householdId, seasonId])
}

// The join between a Subscription and one of the season's holiday Events —
// this is where `skipped` lives (SPEC.md §4.1): a household skipping one
// holiday without cancelling is a flag on this row, not a deleted record.
model SubscriptionEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id])
  skipped        Boolean      @default(false)
  skippedReason  String?
  stopId         String? // set when "generate stops" runs (Phase 2)

  @@unique([subscriptionId, eventId])
}

model Stop {
  id                String     @id @default(cuid())
  eventId           String
  event             Event      @relation(fields: [eventId], references: [id])
  source            StopSource
  householdId       String?
  household         Household? @relation(fields: [householdId], references: [id])
  signupId          String? // Signup model ships in Phase 1/2
  carriedFromStopId String?
  routeId           String? // Route model ships in Phase 3
  sequence          Int?
  status            StopStatus @default(UNASSIGNED)
  lat               Float
  lng               Float
  addressLine       String
  label             String?
  placementNote     String?
  accessNotes       String?
  priority          Int        @default(0)
  estimatedMinutes  Int        @default(4)
  // Not in SPEC.md's base Stop block, but needed to implement §8's
  // FIELD_ADDED behavior ("lands as needsReview, visible to the
  // coordinator immediately") without a later migration. Flagged in
  // docs/rounds/PHASE-0.md as an addition made on our own judgment.
  needsReview       Boolean    @default(false)
  createdAt         DateTime   @default(now())

  @@index([eventId, routeId, sequence])
}

// Copy registry override storage (SPEC.md §11.1). The code-level defaults
// and the t() resolver ship in Phase 0; this table is what an org/event
// override writes to once the copy editor ships in Phase 8. Present now
// so the resolution order (default -> org -> event -> locale) is real
// from day one instead of retrofitted.
model UiCopy {
  id        String   @id @default(cuid())
  orgId     String
  eventId   String?
  locale    String   @default("en")
  key       String
  value     String
  updatedBy String
  updatedAt DateTime @updatedAt

  @@unique([orgId, eventId, locale, key])
}

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  orgId    String
  actorId  String? // null for system; "household:<id>" for self-service, once that exists
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())
  ipHash   String?

  @@index([orgId, at])
}
