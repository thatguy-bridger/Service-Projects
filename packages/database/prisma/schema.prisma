generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_URL_UNPOOLED")
  // ST_DWithin (duplicate detection within 25m), ST_Contains (territory
  // fill) and clustering all need this. See SPEC.md §5.
  extensions = [postgis]
}

// -------------------------------------------------------------------------
// Role. Rounds phase 0 migrates this from ADMIN|USER to five values.
// The migration for this enum is hand-written (see migrations/), not
// autogenerated: ADMIN rows must stay ADMIN and USER rows must become
// PREVIEWER, per SPEC.md §3.1 ("the safe direction — a USER in the old
// schema has no route assignments and should not silently gain access").
// -------------------------------------------------------------------------
enum Role {
  OWNER
  ADMIN
  COORDINATOR
  VOLUNTEER
  PREVIEWER
}

enum EventKind {
  FLAG_SETOUT
  FLAG_PICKUP
  FLYER_DELIVERY
  FUNDRAISER
  PICKUP_COLLECTION
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum StopSource {
  SUBSCRIPTION
  SURVEY
  CSV_IMPORT
  TERRITORY_FILL
  MANUAL_PIN
  CARRIED_OVER
  FIELD_ADDED
}

enum StopStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  DONE
  SKIPPED
  ISSUE
}

enum SubStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  LAPSED
  CANCELLED
}

enum Disposition {
  SUCCESS
  NEUTRAL
  FAILED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime? // NextAuth's PrismaAdapter expects this exact field
  role          Role      @default(PREVIEWER)
  // bcrypt hash, never a plaintext or reversibly-encrypted password. Null
  // for accounts that only ever signed in via OAuth (Google/Microsoft).
  passwordHash  String?
  // Set the first time a new account picks what they're here to do
  // (customer signup vs. volunteer/coordinator interest) at /welcome.
  // Null means "ask them" — checked on every sign-in until then.
  onboardedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Rounds: which orgs/events this user has a role in.
  memberships Membership[]

  // Rounds: which routes this user (a volunteer) is assigned to.
  routeAssignments RouteAssignment[]
  visits           Visit[]
  keyRedemptions   KeyRedemption[]

  // Rounds: households this account is linked to, so a signed-in
  // household doesn't retype its address/contact info every season.
  // Nullable/optional on Household's side — most households never
  // create an account at all (SPEC.md's "no account required" signup
  // is still the default path).
  households Household[]

  // NextAuth PrismaAdapter — Google account linking. No `Session` model:
  // both apps use the "jwt" session strategy, and NextAuth never calls the
  // adapter's session methods under that strategy, so it's safe to omit.
  accounts Account[]
}

// NextAuth v4 PrismaAdapter's expected shape for OAuth account linking
// (Google). Field names are fixed by the adapter, not ours to rename.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth v4 PrismaAdapter's expected shape for email magic-link tokens.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =========================================================================
// Rounds (apps/rounds) — Phase 0 + Phase 1 (flag subscription model)
// See SPEC.md §5. Still not added: Signup, FormSchema, Notification —
// they land with the phases that need them.
// =========================================================================

model Organization {
  id       String @id @default(cuid())
  name     String
  slug     String @unique
  branding Json   @default("{}") // logo, accent override, terminology pack — SPEC.md §11.2
  settings Json   @default("{}") // feature flags, timezone, stripeAccountId

  memberships Membership[]
  events      Event[]
  households  Household[]
  categories  Category[]
  inviteKeys  InviteKey[]
  territories Territory[]
  copyOverrides UiCopyOverride[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?
}

// SPEC.md §5.1, §9.2. A saved, reusable polygon (drawn on the Google Map
// added for Phase 3's route builder) — the "drawing/saving" half of
// Phase 6's territory work. `addressPointCount`/`lastFilledAt` stay null
// until the fill step (UGRC address-point import) lands; that needs a
// UGRC developer key this environment doesn't have — see
// docs/rounds/OPEN-QUESTIONS.md.
model Territory {
  id                String       @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id])
  name              String
  polygon           Json // GeoJSON-shaped: { type: "Polygon", coordinates: [[[lng, lat], ...]] }
  addressPointCount Int?
  lastFilledAt      DateTime?
  createdAt         DateTime     @default(now())
  deletedAt         DateTime?

  @@index([orgId])
}

// SPEC.md §9.2/§9.1's real intended architecture for territory fill:
// "Import the county subset of address points into your own Postgres
// once and refresh quarterly... a live API call per polygon fill is
// slower, rate-limited, and no fresher." Not org-scoped -- this is
// shared reference geodata (every Utah address point this deployment
// has imported), not per-org data, so every org on a deployment shares
// one pool. `source` is a free-form batch label an admin picks at
// import time (e.g. "Salt Lake County 2027-Q1") -- re-importing the
// same source label replaces that batch's rows entirely rather than
// appending duplicates, so re-running an import is how a refresh
// works. lat/lng as plain floats, not a geography column, matching
// every other coordinate pair in this schema (Household, Stop) --
// spatial queries against this table cast to geography in raw SQL,
// same as findNearbyHouseholds.
model AddressPoint {
  id          String   @id @default(cuid())
  lat         Float
  lng         Float
  fullAddress String
  city        String?
  zip         String?
  source      String
  importedAt  DateTime @default(now())

  @@index([source])
  @@index([lat, lng])
}

// SPEC.md §11.1's "org override" layer of the copy resolution chain
// (default in code -> org override -> event override -> locale ->
// rendered). Storage + admin editor only for now -- the `en.ts`
// default layer and apps/rounds/src/copy/t.ts's createT(overrides)
// already support layering overrides in, but every current call site
// imports the singleton `t` (defaults only) directly rather than a
// per-request, org-scoped instance; wiring every screen through a
// request-scoped t() is real follow-up scope, not attempted here. An
// empty/missing `value` means "no override, use the code default" --
// there's deliberately no way to store an override that's an empty
// string distinct from "not overridden."
model UiCopyOverride {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  key       String
  value     String
  updatedAt DateTime     @updatedAt
  updatedBy String?

  @@unique([orgId, key])
}

// User-managed replacement for the old hardcoded EventKind directory
// grouping -- an org can create, rename, and delete its own categories to
// organize events. `kind` stays on Event (module/outcome defaults still
// key off it), but the browsable "category" grouping in /admin/events is
// now this model, not a fixed enum.
// User-managed grouping of events, and (optionally) their shared bundle
// pricing. Also the replacement for the old Season model: a household
// used to sign up for a Season for one price covering a bundle of
// holiday Events; now that same "sign up once, cover several Events"
// behavior lives here — set priceCents to charge one flat price across
// every Event in this Category regardless of which subset a household
// selects, or leave it null to charge each Event's own price and sum
// them (see Subscription.categoryId, Event.priceCents below).
model Category {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  name        String
  slug        String
  sortOrder   Int          @default(0)
  priceCents  Int? // null = sum each selected Event's own priceCents
  publishedAt DateTime? // null = not visible on public signup. Publishing
  // is now done at the category level, not per-event — see
  // openEventsForSignup: an Event only shows on /signup when its
  // Category is published *and* the Event's own status is OPEN, so
  // "publish the category" is the one bulk action, while an admin can
  // still pull a single event out (CLOSED) or hold a newly-added one
  // back (DRAFT) without unpublishing the whole category.
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?

  events        Event[]
  subscriptions Subscription[]

  @@unique([orgId, slug])
}

model Membership {
  id              String       @id @default(cuid())
  orgId           String
  organization    Organization @relation(fields: [orgId], references: [id])
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  role            Role
  eventId         String? // null = org-wide
  event           Event?       @relation(fields: [eventId], references: [id])
  grantedBy       String?
  grantedViaKeyId String? // InviteKey ships in Phase 5; kept as a plain id for now
  status          String       @default("active")
  createdAt       DateTime     @default(now())

  @@unique([orgId, userId, role, eventId])
  @@index([userId])
}

model Event {
  id              String       @id @default(cuid())
  orgId           String
  organization    Organization @relation(fields: [orgId], references: [id])
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id])
  kind            EventKind
  name            String
  slug            String
  status          EventStatus  @default(DRAFT)
  summary         String?
  descriptionMd   String?
  coverImageUrl   String?
  priceCents      Int          @default(0) // this Event's own price; see Category.priceCents for bundle pricing
  serviceStartsAt DateTime
  serviceEndsAt   DateTime
  signupsCloseAt  DateTime?
  timezone        String       @default("America/Denver")
  depotLat        Float?
  depotLng        Float?
  pairedEventId   String? // FLAG_SETOUT <-> FLAG_PICKUP, SPEC.md §2.1
  modules         Json // resolved module matrix, SPEC.md §2.1
  outcomeSet      Json // this kind's visit outcomes, overridable
  copyOverrides   Json?
  layoutBlocks    Json?
  createdBy       String
  createdAt       DateTime     @default(now())
  deletedAt       DateTime?

  stops              Stop[]
  routes             Route[]
  memberships        Membership[]
  subscriptionEvents SubscriptionEvent[]
  inviteKeys         InviteKey[]

  @@unique([orgId, slug])
}

model Household {
  id                        String       @id @default(cuid())
  orgId                     String
  organization              Organization @relation(fields: [orgId], references: [id])
  // Optional link to a real account — set when the household chooses to
  // "create an account" after a signup, so a future signed-in visit can
  // prefill their contact/address instead of asking again. Most
  // households never link one; the public signup form works with none.
  userId                    String?
  user                      User?        @relation(fields: [userId], references: [id])
  contactName               String
  contactEmail              String?
  contactPhone              String?
  addressInput              String // exactly what they typed
  address                   Json // normalised components from the geocoder
  lat                       Float?
  lng                       Float?
  geocodeConfidence         Float?
  geocodeSource             String? // "ugrc" | "manual_pin"
  needsReview               Boolean      @default(false)
  // Freeform, admin-facing only — why this landed in the review queue
  // ("manual address entry", "possible duplicate of <id>", etc.) so the
  // queue is actually actionable instead of just a flag with no reason.
  needsReviewReason         String?
  placementNote             String? // "left of the driveway"
  accessNotes               String? // dog, stairs, sprinklers
  language                  String       @default("en")
  selfServiceTokenHash      String?
  // SPEC.md §4.4: 400-day expiry on the self-service link. Null means no
  // token has been issued yet (pre-Phase-2 households, or ones that
  // opted for account-linking instead — see householdForUser/
  // linkHouseholdToUser — and never got a token).
  selfServiceTokenExpiresAt DateTime?

  stops         Stop[]
  subscriptions Subscription[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([orgId, lat, lng])
  @@index([userId])
}

model Subscription {
  id                      String    @id @default(cuid())
  householdId             String
  household               Household @relation(fields: [householdId], references: [id])
  // Which bundle this signup belongs to, if any -- set only when every
  // selected Event shares one Category; a mixed selection (or entirely
  // uncategorized Events) leaves this null. Nullable, so no uniqueness
  // constraint on (householdId, categoryId) -- a household can have
  // several uncategorized Subscriptions.
  categoryId              String?
  category                Category? @relation(fields: [categoryId], references: [id])
  status                  SubStatus @default(DRAFT)
  amountCents             Int
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  renewedFromId           String? // last year's subscription
  cancelledAt             DateTime?

  events SubscriptionEvent[]

  createdAt DateTime @default(now())

  // A real DB-level uniqueness rule also exists here, enforced by a raw
  // migration (20260806150000_subscription_category_unique) rather than
  // this @@index: a partial unique index on (householdId, categoryId)
  // WHERE categoryId IS NOT NULL. Prisma's schema DSL can't express
  // "unique, but only when non-null" directly, so it isn't declared as
  // @@unique here -- but it's real at the database level and is what
  // actually prevents two concurrent requests from creating duplicate
  // Subscriptions for the same household + category.
  @@index([householdId, categoryId])
}

// The join between a Subscription and one of the season's holiday Events —
// this is where `skipped` lives (SPEC.md §4.1): a household skipping one
// holiday without cancelling is a flag on this row, not a deleted record.
model SubscriptionEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id])
  skipped        Boolean      @default(false)
  skippedReason  String?
  stopId         String? // set when "generate stops" runs (Phase 2)

  @@unique([subscriptionId, eventId])
}

model Stop {
  id                String     @id @default(cuid())
  eventId           String
  event             Event      @relation(fields: [eventId], references: [id])
  source            StopSource
  householdId       String?
  household         Household? @relation(fields: [householdId], references: [id])
  signupId          String? // Signup model ships in Phase 1/2
  carriedFromStopId String?
  routeId           String?
  route             Route?     @relation(fields: [routeId], references: [id])
  sequence          Int?
  status            StopStatus @default(UNASSIGNED)
  lat               Float
  lng               Float
  addressLine       String
  label             String?
  placementNote     String?
  accessNotes       String?
  priority          Int        @default(0)
  estimatedMinutes  Int        @default(4)
  // Not in SPEC.md's base Stop block, but needed to implement §8's
  // FIELD_ADDED behavior ("lands as needsReview, visible to the
  // coordinator immediately") without a later migration. Flagged in
  // docs/rounds/PHASE-0.md as an addition made on our own judgment.
  needsReview       Boolean    @default(false)
  createdAt         DateTime   @default(now())

  visits Visit[]

  @@index([eventId, routeId, sequence])
}

// Phase 3 (SPEC.md §9.3): an ordered list of stops assigned to one or
// more volunteers. Deliberately scoped down from SPEC.md's full model
// for a first real, working slice -- geometry/plannedDistanceM/
// briefingMd/travelMode etc. are real fields for later (route map,
// offline briefing) once that UI exists; not added speculatively ahead
// of a consumer, same rule the rest of this schema follows.
model Route {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id])
  name      String
  color     String    @default("#6f4ef0")
  status    String    @default("draft") // draft|published|in_progress|complete
  createdBy String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  stops       Stop[]
  assignments RouteAssignment[]
  visits      Visit[]
}

model RouteAssignment {
  id         String    @id @default(cuid())
  routeId    String
  route      Route     @relation(fields: [routeId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  role       String    @default("lead") // lead|helper
  assignedBy String
  assignedAt DateTime  @default(now())
  acceptedAt DateTime?

  @@unique([routeId, userId])
}

// Phase 4 (SPEC.md §9.4/16): one recorded outcome at one stop by one
// volunteer -- "left at door", "no answer", whatever the event's own
// outcomeSet defines (Stop's/Event's `outcomeSet` JSON, not re-validated
// here; the field app's own outcome picker is the one place that has to
// agree with it). `clientId` is generated client-side before the
// request goes out, so a retried request (flaky connection, double
// tap) can't create a duplicate Visit -- worth having from day one even
// before Phase 7's offline queue actually needs it, since the mobile
// network conditions that motivate offline support are exactly the ones
// that cause a request to look like it failed when it actually
// succeeded.
model Visit {
  id              String      @id @default(cuid())
  stopId          String
  stop            Stop        @relation(fields: [stopId], references: [id])
  routeId         String
  route           Route       @relation(fields: [routeId], references: [id])
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  outcome         String
  disposition     Disposition
  note            String?
  photoUrl        String?
  itemCount       Int?
  amountCents     Int?
  minutesSpent    Int?
  recordedAt      DateTime    @default(now())
  syncedAt        DateTime?
  recordedOffline Boolean     @default(false)
  clientId        String      @unique
}

// Phase 5 (SPEC.md §5's InviteKey block): a shareable code that grants a
// role on redemption -- how an Owner/Admin brings on a Coordinator or
// Volunteer without hand-editing /admin/users. Never stores the raw
// code, same hash-and-compare pattern as Household's self-service token
// (households.ts's hashToken/issueSelfServiceToken) -- possession of the
// raw code is what grants access, not a stored secret an attacker could
// read off a database dump.
model InviteKey {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  eventId    String? // null = org-wide role grant
  event      Event?       @relation(fields: [eventId], references: [id])
  codeHash   String       @unique
  codePrefix String // first few chars, shown in the admin UI so a key is identifiable without ever re-showing the raw code
  grantsRole Role
  maxUses    Int          @default(1)
  useCount   Int          @default(0)
  expiresAt  DateTime?
  note       String?
  revokedAt  DateTime?
  createdBy  String
  createdAt  DateTime     @default(now())

  redemptions KeyRedemption[]
}

model KeyRedemption {
  id         String    @id @default(cuid())
  keyId      String
  key        InviteKey @relation(fields: [keyId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  redeemedAt DateTime  @default(now())

  @@unique([keyId, userId])
}

// Copy registry override storage (SPEC.md §11.1). The code-level defaults
// and the t() resolver ship in Phase 0; this table is what an org/event
// override writes to once the copy editor ships in Phase 8. Present now
// so the resolution order (default -> org -> event -> locale) is real
// from day one instead of retrofitted.
model UiCopy {
  id        String   @id @default(cuid())
  orgId     String
  eventId   String?
  locale    String   @default("en")
  key       String
  value     String
  updatedBy String
  updatedAt DateTime @updatedAt

  @@unique([orgId, eventId, locale, key])
}

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  orgId    String
  actorId  String? // null for system; "household:<id>" for self-service, once that exists
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())
  ipHash   String?

  @@index([orgId, at])
}
